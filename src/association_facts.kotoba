;; The JICPA source catalog, as Kotoba.
;;
;; Ported from `src/association/facts.cljc`, which stays as the data-shaped
;; reading of the same `data/datascript-tx.edn`. This is the form every
;; already-ported sibling uses -- `association-covered?`, `entry-count`,
;; `entry-field`, `topic*`, `by-topic*`, `coverage-note` -- so a consumer can
;; reach the catalog through the Kotoba oracle rather than only from a JVM or a
;; JS host.
;;
;; ── one thing the port had to DECIDE, not preserve ──
;;
;; `:association-rule/topic` is a SET in the cljc. A set has no order, and
;; `topic` here is indexed by position, so the port has to choose one. It uses
;; the order the source file writes them in. `by-topic-id` is unaffected -- it
;; answers by name, not by index -- so the only thing riding on the choice is
;; what `(topic … 0)` returns, and the parity test compares against the same
;; written order rather than against `seq` on a set, which is not stable to
;; rely on.
;;
;; Parity: test/association_facts_kotoba_parity_test.clj

(ns association-facts
  (:export [main association-covered? entry-count entry-field topic-count
            topic by-topic-count by-topic-id coverage-note]))

(defn association-covered? [a :string] :bool
  ;; `:bool`, not `:i64`: `string=?` returns a boolean and `bool is a type, not
  ;; a number` is permanent. The already-ported siblings all had to be moved
  ;; off `:i64` for this reason; a new one starts correct.
  (string=? a "jicpa"))

(defn entry-count [a :string] :i64
  (if (association-covered? a) 2 0))

(defn valid-entry? [a :string i :i64] :bool
  (if (association-covered? a)
    (if (= i 0) true (if (= i 1) true false))
    false))

(defn entry-field [a :string i :i64 f :string] [:option :string]
  (if (valid-entry? a i)
    (if (= i 0)
      (cond
        (string=? f "id") (option-some-of [:option :string] "jicpa.ethics-rules")
        (string=? f "title") (option-some-of [:option :string] "倫理規則 (Ethics Rules)")
        (string=? f "association") (option-some-of [:option :string] "jicpa")
        (string=? f "isic") (option-some-of [:option :string] "6920")
        (string=? f "country") (option-some-of [:option :string] "JPN")
        (string=? f "kind") (option-some-of [:option :string] "self-regulatory-code")
        (string=? f "url") (option-some-of [:option :string] "https://jicpa.or.jp/specialized_field/2-22-0-2-20190618.pdf")
        (string=? f "url-provenance") (option-some-of [:option :string] "official-association-site")
        (string=? f "established-date") (option-some-of [:option :string] "1966-12-01")
        (string=? f "retrieved-at") (option-some-of [:option :string] "2026-07-15")
        :else (option-none-of [:option :string]))
      (cond
        (string=? f "id") (option-some-of [:option :string] "jicpa.self-regulatory-initiatives")
        (string=? f "title") (option-some-of [:option :string] "自主規制の取り組み (Self-Regulatory Initiatives)")
        (string=? f "association") (option-some-of [:option :string] "jicpa")
        (string=? f "isic") (option-some-of [:option :string] "6920")
        (string=? f "country") (option-some-of [:option :string] "JPN")
        (string=? f "kind") (option-some-of [:option :string] "governance-program")
        (string=? f "url") (option-some-of [:option :string] "https://jicpa.or.jp/about/activity/self-regulatory/criterion/")
        (string=? f "url-provenance") (option-some-of [:option :string] "official-association-site")
        ;; no established-date on this entry, and absent is not empty
        (string=? f "retrieved-at") (option-some-of [:option :string] "2026-07-15")
        :else (option-none-of [:option :string])))
    (option-none-of [:option :string])))

(defn topic-count [a :string i :i64] :i64
  ;; Entry 0 carries three topics, entry 1 carries two. Writing one number for
  ;; both is the mistake this function invites, and the parity test below is
  ;; what caught it.
  (if (valid-entry? a i) (if (= i 0) 3 2) 0))

(defn topic [a :string i :i64 t :i64] [:option :string]
  (if (valid-entry? a i)
    (if (= i 0)
      (if (= t 0) (option-some-of [:option :string] "ethics")
          (if (= t 1) (option-some-of [:option :string] "independence")
              (if (= t 2) (option-some-of [:option :string] "member-conduct")
                  (option-none-of [:option :string]))))
      (if (= t 0) (option-some-of [:option :string] "governance")
          (if (= t 1) (option-some-of [:option :string] "audit-quality")
              (option-none-of [:option :string]))))
    (option-none-of [:option :string])))

(defn by-topic-count [a :string candidate :string] :i64
  (if (association-covered? a)
    (if (string=? candidate "ethics") 1
        (if (string=? candidate "independence") 1
            (if (string=? candidate "member-conduct") 1
                (if (string=? candidate "governance") 1
                    (if (string=? candidate "audit-quality") 1 0)))))
    0))

(defn by-topic-id [a :string candidate :string i :i64] [:option :string]
  (if (association-covered? a)
    (if (= i 0)
      (if (string=? candidate "ethics") (entry-field a 0 "id")
          (if (string=? candidate "independence") (entry-field a 0 "id")
              (if (string=? candidate "member-conduct") (entry-field a 0 "id")
                  (if (string=? candidate "governance") (entry-field a 1 "id")
                      (if (string=? candidate "audit-quality") (entry-field a 1 "id")
                          (option-none-of [:option :string]))))))
      (option-none-of [:option :string]))
    (option-none-of [:option :string])))

(defn coverage-note [a :string] [:option :string]
  (if (association-covered? a)
    (option-some-of [:option :string]
      "cloud-itonami-assoc-6920-jpn-jicpa Wave 0 (ADR-2607141700): 2 jicpa entries seeded with an official jicpa.or.jp citation. Extend the sovereign catalog; never fabricate a rule id/url.")
    (option-none-of [:option :string])))

(defn main [] :i64 0)
