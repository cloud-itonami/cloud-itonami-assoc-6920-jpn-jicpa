  (cond
    (string=? f "id") (option-some-of [:option :string] "jicpa.ethics-practice-guidance-1")
    (string=? f "title") (option-some-of [:option :string] "倫理規則実務ガイダンス第１号「倫理規則に関するQ&A（実務ガイダンス）」")
    (string=? f "association") (option-some-of [:option :string] "jicpa")
    (string=? f "isic") (option-some-of [:option :string] "6920")
    (string=? f "country") (option-some-of [:option :string] "JPN")
    (string=? f "kind") (option-some-of [:option :string] "practice-guidance")
    (string=? f "url") (option-some-of [:option :string] "https://jicpa.or.jp/specialized_field/files/2-22-1-2a-20260430r.pdf")
    (string=? f "url-provenance") (option-some-of [:option :string] "official-association-site")
    (string=? f "established-date") (option-some-of [:option :string] "2022-12-15")
    (string=? f "last-revised-date") (option-some-of [:option :string] "2026-04-17")
    (string=? f "retrieved-at") (option-some-of [:option :string] "2026-09-06")
    :else (option-none-of [:option :string])))

(defn field-3 [f :string] [:option :string]
  (cond
    (string=? f "id") (option-some-of [:option :string] "jicpa.quality-control-review")
    (string=? f "title") (option-some-of [:option :string] "品質管理レビュー制度 (Quality Control Review System)")
    (string=? f "association") (option-some-of [:option :string] "jicpa")
    (string=? f "isic") (option-some-of [:option :string] "6920")
    (string=? f "country") (option-some-of [:option :string] "JPN")
    (string=? f "kind") (option-some-of [:option :string] "governance-program")
    (string=? f "url") (option-some-of [:option :string] "https://jicpa.or.jp/about/activity/self-regulatory/quality/")
    (string=? f "url-provenance") (option-some-of [:option :string] "official-association-site")
    (string=? f "retrieved-at") (option-some-of [:option :string] "2026-09-06")
    :else (option-none-of [:option :string])))

(defn field-4 [f :string] [:option :string]
  (cond
    (string=? f "id") (option-some-of [:option :string] "jicpa.listed-company-auditor-registration")
    (string=? f "title") (option-some-of [:option :string] "上場会社等監査人登録制度 (Listed Company Audit Firm Registration System)")
    (string=? f "association") (option-some-of [:option :string] "jicpa")
    (string=? f "isic") (option-some-of [:option :string] "6920")
    (string=? f "country") (option-some-of [:option :string] "JPN")
    (string=? f "kind") (option-some-of [:option :string] "governance-program")
    (string=? f "url") (option-some-of [:option :string] "https://jicpa.or.jp/about/activity/self-regulatory/lcaf/")
    (string=? f "url-provenance") (option-some-of [:option :string] "official-association-site")
    (string=? f "retrieved-at") (option-some-of [:option :string] "2026-09-06")
    :else (option-none-of [:option :string])))

(defn field-5 [f :string] [:option :string]
  (cond
    (string=? f "id") (option-some-of [:option :string] "jicpa.case-inspection")
    (string=? f "title") (option-some-of [:option :string] "個別事案審査制度 (Individual Case Review System)")
    (string=? f "association") (option-some-of [:option :string] "jicpa")
    (string=? f "isic") (option-some-of [:option :string] "6920")
    (string=? f "country") (option-some-of [:option :string] "JPN")
    (string=? f "kind") (option-some-of [:option :string] "governance-program")
    (string=? f "url") (option-some-of [:option :string] "https://jicpa.or.jp/about/activity/self-regulatory/inspection/")
    (string=? f "url-provenance") (option-some-of [:option :string] "official-association-site")
    (string=? f "retrieved-at") (option-some-of [:option :string] "2026-09-06")
    :else (option-none-of [:option :string])))

(defn field-6 [f :string] [:option :string]
  (cond
    (string=? f "id") (option-some-of [:option :string] "jicpa.self-regulation-monitoring")
    (string=? f "title") (option-some-of [:option :string] "自主規制のモニタリング (Self-Regulation Monitoring)")
    (string=? f "association") (option-some-of [:option :string] "jicpa")
    (string=? f "isic") (option-some-of [:option :string] "6920")
    (string=? f "country") (option-some-of [:option :string] "JPN")
    (string=? f "kind") (option-some-of [:option :string] "governance-program")
    (string=? f "url") (option-some-of [:option :string] "https://jicpa.or.jp/about/activity/self-regulatory/monitoring/")
    (string=? f "url-provenance") (option-some-of [:option :string] "official-association-site")
    (string=? f "retrieved-at") (option-some-of [:option :string] "2026-09-06")
    :else (option-none-of [:option :string])))

(defn entry-field [a :string i :i64 f :string] [:option :string]
  (if (valid-entry? a i)
    (cond
      (= i 0) (field-0 f)
      (= i 1) (field-1 f)
      (= i 2) (field-2 f)
      (= i 3) (field-3 f)
      (= i 4) (field-4 f)
      (= i 5) (field-5 f)
      (= i 6) (field-6 f)
      :else (option-none-of [:option :string]))
    (option-none-of [:option :string])))

(defn topic-count [a :string i :i64] :i64
  ;; Entries 0 and 5 carry three topics, the rest carry two. Writing one number
  ;; for every entry is the mistake this function invites, and the parity test
  ;; is what caught it the first time.
  (if (valid-entry? a i)
    (cond
      (= i 0) 3
      (= i 5) 3
      :else 2)
    0))

(defn topic [a :string i :i64 t :i64] [:option :string]
  (if (valid-entry? a i)
    (cond
      (= i 0) (cond (= t 0) (option-some-of [:option :string] "ethics")
                    (= t 1) (option-some-of [:option :string] "independence")
                    (= t 2) (option-some-of [:option :string] "member-conduct")
                    :else (option-none-of [:option :string]))
      (= i 1) (cond (= t 0) (option-some-of [:option :string] "governance")
                    (= t 1) (option-some-of [:option :string] "audit-quality")
                    :else (option-none-of [:option :string]))
      (= i 2) (cond (= t 0) (option-some-of [:option :string] "ethics")
                    (= t 1) (option-some-of [:option :string] "independence")
                    :else (option-none-of [:option :string]))
      (= i 3) (cond (= t 0) (option-some-of [:option :string] "governance")
                    (= t 1) (option-some-of [:option :string] "audit-quality")
                    :else (option-none-of [:option :string]))
      (= i 4) (cond (= t 0) (option-some-of [:option :string] "governance")
                    (= t 1) (option-some-of [:option :string] "registration")
                    :else (option-none-of [:option :string]))
      (= i 5) (cond (= t 0) (option-some-of [:option :string] "governance")
                    (= t 1) (option-some-of [:option :string] "discipline")
                    (= t 2) (option-some-of [:option :string] "member-conduct")
                    :else (option-none-of [:option :string]))
      (= i 6) (cond (= t 0) (option-some-of [:option :string] "governance")
                    (= t 1) (option-some-of [:option :string] "oversight")
                    :else (option-none-of [:option :string]))
      :else (option-none-of [:option :string]))
    (option-none-of [:option :string])))

(defn by-topic-count [a :string candidate :string] :i64
  ;; How many entries carry the topic. With seven entries these stopped being
  ;; all-ones, which is the whole reason the parity test compares this against
  ;; `(count (facts/by-topic …))` instead of against a literal.
  (if (association-covered? a)
    (cond
      (string=? candidate "ethics") 2
      (string=? candidate "independence") 2
      (string=? candidate "member-conduct") 2
      (string=? candidate "governance") 5
      (string=? candidate "audit-quality") 2
      (string=? candidate "registration") 1
      (string=? candidate "discipline") 1
      (string=? candidate "oversight") 1
      :else 0)
    0))

(defn by-topic-entry-index [candidate :string i :i64] :i64
  ;; Entry index of the i-th entry carrying `candidate`, in catalog order.
  ;; 99 means "no such entry" -- out of range for a seven-entry catalog, so
  ;; `entry-field` rejects it through `valid-entry?` and NONE comes back
  ;; without a second check here. A sentinel that has to be tested separately
  ;; is a sentinel someone forgets to test.
  (cond
    (string=? candidate "ethics")
    (cond (= i 0) 0 (= i 1) 2 :else 99)
    (string=? candidate "independence")
    (cond (= i 0) 0 (= i 1) 2 :else 99)
    (string=? candidate "member-conduct")
    (cond (= i 0) 0 (= i 1) 5 :else 99)
    (string=? candidate "governance")
    (cond (= i 0) 1 (= i 1) 3 (= i 2) 4 (= i 3) 5 (= i 4) 6 :else 99)
    (string=? candidate "audit-quality")
    (cond (= i 0) 1 (= i 1) 3 :else 99)
    (string=? candidate "registration")
    (cond (= i 0) 4 :else 99)
    (string=? candidate "discipline")
    (cond (= i 0) 5 :else 99)
    (string=? candidate "oversight")
    (cond (= i 0) 6 :else 99)
    :else 99))

(defn by-topic-id [a :string candidate :string i :i64] [:option :string]
  ;; Answers every index, not just the first. The port used to answer only
  ;; index 0 and NONE for the rest, which was indistinguishable from a topic
  ;; carried by exactly one entry -- true for every topic back when the
  ;; catalog held two entries, and false for five of the eight topics now.
  (entry-field a (by-topic-entry-index candidate i) "id"))

(defn coverage-note [a :string] [:option :string]
  (if (association-covered? a)
    (option-some-of [:option :string]
      "cloud-itonami-assoc-6920-jpn-jicpa Wave 0 (ADR-2607141700): 7 jicpa entries seeded with an official jicpa.or.jp citation. Extend the sovereign catalog; never fabricate a rule id/url.")
    (option-none-of [:option :string])))

(defn main [] :i64 0)
